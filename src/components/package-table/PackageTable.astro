---
import type { Distro } from "../../data/distros";
import { browseUrl, isDeprecated } from "../../data/distros";
import PackageTable from "./PackageTable.svelte";

interface Props {
  distro: Distro;
}

const { distro } = Astro.props;
const browse = browseUrl(distro);
const requestable = !isDeprecated(distro) && distro.status !== "eol";
---

{/*
  The `requestable` prop shows the per-row "Add to channel" button, which opens
  a package request in the RoboStack/robostack monorepo. Only the distros the
  monorepo builds get it: inviting contributions to a distro nobody rebuilds,
  or one upstream has stopped supporting, would waste someone's afternoon.

  The island renders and updates everything itself; this wrapper only feeds
  it the distro facts that are known at build time.
*/}
<PackageTable
  client:load
  distro={distro.name}
  requestable={requestable}
  browse={browse}
/>
<noscript>
  <p>
    This table is rendered in the browser. Without JavaScript, browse the
    channel directly at <a href={browse}>{browse.replace("https://", "")}</a>.
  </p>
</noscript>
