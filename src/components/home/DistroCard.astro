---
interface Props {
  href: string;
  channel: string;
  name: string;
  description: string;
}

const { href, channel, name, description } = Astro.props;
---

<a class="rs-card card" href={href}>
  <div class="top">
    <span class="channel"><code>{channel}</code></span>
  </div>
  <div class="name">{name}</div>
  <div class="sub">{description}</div>
  <span class="link">Package list &rarr;</span>
</a>

<style>
  .card {
    display: block;
    padding: 22px;
    color: var(--fg-1);
    text-decoration: none;
    transition: box-shadow var(--dur-3) var(--ease-out);
  }
  .card:hover {
    box-shadow: var(--shadow-hover-accent);
    text-decoration: none;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .channel code {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    background: none;
    padding: 0;
    color: var(--fg-1);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 26px;
    margin-bottom: 6px;
  }
  .sub {
    font-size: 13px;
    color: var(--fg-2);
    line-height: 1.5;
    margin-bottom: 14px;
  }
  .link {
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-copy);
  }
</style>
