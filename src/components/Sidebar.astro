---
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";

import SidebarList from "./SidebarList.astro";

/**
 * Override of Starlight's Sidebar that shows every group expanded, without
 * the collapse toggles (see SidebarList.astro). The persister still restores
 * the sidebar's scroll position between pages.
 */
const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
  <SidebarList entries={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
