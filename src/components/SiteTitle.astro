---
import Logo from "./Logo.astro";

/**
 * Override of Starlight's SiteTitle: renders the wordmark inline instead of
 * via `config.logo`, so it follows `currentColor` in both color schemes.
 * The site name stays in the DOM for assistive technology.
 */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <Logo />
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    /* The wordmark rides the strong text color - ink navy in light, warm
       white in dark - like the original logo, not the accent. */
    color: var(--sl-color-white);
    text-decoration: none;
    min-width: 0;
  }
  .site-title :global(svg) {
    height: calc(var(--sl-nav-height) - 2.4 * var(--sl-nav-pad-y));
    width: auto;
  }
</style>
